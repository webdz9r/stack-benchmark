{
  "name": "node",
  "label": "Node",
  "description": "Fastify, better-sqlite3 on worker threads",
  "port": 7880,
  "requires": [
    "node",
    "npm"
  ],
  "versions": [
    "node --version"
  ],
  "build": [
    "npm install --no-audit --no-fund --silent"
  ],
  "start": "node src/main.js",
  "seed": "node src/seed.js {count}",
  "env": {
    "PORT": "{port}",
    "DB_READERS": "{cores}"
  },
  "concurrency": "1 process: event loop + {cores} reader threads + 1 writer thread",
  "docker": {
    "start": "serve",
    "seed": "seed {count}",
    "env": {
      "HOST": "0.0.0.0"
    }
  }
}
